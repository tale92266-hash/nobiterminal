+    <string name="nobi_notifications_title">Notifications</string>
+    <string name="nobi_notifications_view">View notifications</string>
+    <string name="nobi_notifications_empty_no_access">Notification access is off, so there is nothing to show here. Turn it on to read your notifications inside NobiTerminal. Nothing is sent anywhere.</string>
