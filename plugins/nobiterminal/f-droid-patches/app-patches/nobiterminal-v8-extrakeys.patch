@@ -0,0 +1,34 @@
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+
+    <!-- v8 (icon audit): app icon as a DRAWABLE, not a mipmap reference.
+         The legacy Termux PNGs in the density mipmap folders cannot be
+         deleted by a text patch (GNU patch refuses binary hunks, which is
+         why they survived v6), and on density-qualified lookup they
+         shadow the anydpi vector — that is why Funtouch showed the old
+         black >_ square in the notification shade. A drawable has no
+         density-mipmap rival, so this navy + neon "N" vector (same art
+         as the mipmap-anydpi fallback) is what every icon path now
+         resolves to. The density PNGs remain in the APK as dead files
+         that no UI path references. -->
+
+    <path
+        android:fillColor="#070B1F"
+        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
+
+    <group
+        android:translateX="3"
+        android:translateY="3">
+        <path
+            android:fillColor="#8B5CF6"
+            android:pathData="M30,78 L30,30 L40,30 L66,62 L66,30 L78,30 L78,78 L68,78 L42,46 L42,78 Z" />
+    </group>
+
+    <path
+        android:fillColor="#22D3EE"
+        android:pathData="M30,78 L30,30 L40,30 L66,62 L66,30 L78,30 L78,78 L68,78 L42,46 L42,78 Z" />
+
+</vector>
