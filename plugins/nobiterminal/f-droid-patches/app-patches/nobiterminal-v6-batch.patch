+                        continue
+                    }
+                    if (c == '\'') inChar = false
+                    i++
+                    continue
+                }
+                if (c == '/' && i + 1 < raw.length && raw[i + 1] == '/') break
+                if (c == '/' && i + 1 < raw.length && raw[i + 1] == '*') {
+                    inBlockComment = true
+                    i += 2
+                    continue
+                }
+                if (c == '"') {
+                    inString = true
+                    stringDelim = '"'
+                    i++
+                    firstSignificant = false
+                    continue
+                }
+                if (c == '\'') {
+                    inChar = true
+                    i++
+                    firstSignificant = false
+                    continue
+                }
+                if (c == ' ' || c == '\t') {
