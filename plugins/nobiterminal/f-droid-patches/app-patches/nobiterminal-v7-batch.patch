+++ b/termux-app/app/src/main/java/com/termux/app/nobi/NobiPlaybackActivity.java
@@ -0,0 +1,122 @@
+package com.termux.app.nobi;
+
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AppCompatActivity;
+
+import java.io.BufferedReader;
+import java.io.File;
+import java.io.FileReader;
+import java.util.ArrayList;
+import java.util.List;
+
+/** v7 (37): replays a .cast.json recording with its original timing. */
+public class NobiPlaybackActivity extends AppCompatActivity {
+
+    private TextView textView;
+    private ScrollView scrollView;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+
+    private static class Frame {
+        long t;
+        String text;
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        scrollView = new ScrollView(this);
+        textView = new TextView(this);
+        textView.setTypeface(android.graphics.Typeface.MONOSPACE);
+        textView.setTextSize(13);
+        int pad = (int) (12 * getResources().getDisplayMetrics().density);
+        textView.setPadding(pad, pad, pad, pad);
+        scrollView.addView(textView);
+        setContentView(scrollView);
+
+        String name = getIntent().getStringExtra("recording_name");
+        if (name == null) {
+            finish();
+            return;
+        }
+        List<Frame> frames = loadFrames(new File(NobiRecordingManager.recordingsDir(this),
+            name + ".cast.json"));
+        if (frames.isEmpty()) {
+            Toast.makeText(this, "Recording is empty", Toast.LENGTH_SHORT).show();
+            finish();
+            return;
+        }
+        setTitle("Playback: " + name);
+        for (Frame frame : frames) {
+            handler.postDelayed(() -> {
+                textView.append(frame.text);
+                scrollView.post(() -> scrollView.fullScroll(ScrollView.FOCUS_DOWN));
+            }, Math.max(0, frame.t));
+        }
+    }
+
+    private List<Frame> loadFrames(File file) {
+        List<Frame> out = new ArrayList<>();
+        try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                Frame frame = parseFrame(line);
+                if (frame != null) out.add(frame);
+            }
+        } catch (Exception ignored) {
+        }
+        return out;
+    }
+
+    private Frame parseFrame(String line) {
+        try {
+            int tIndex = line.indexOf("\"t\":");
+            if (tIndex < 0) return null;
+            int tEnd = line.indexOf(',', tIndex);
+            Frame frame = new Frame();
+            frame.t = Long.parseLong(line.substring(tIndex + 4, tEnd).trim());
+            int textIndex = line.indexOf("\"text\":\"", tEnd);
+            if (textIndex < 0) return null;
+            int textStart = textIndex + 8;
+            StringBuilder sb = new StringBuilder();
+            for (int i = textStart; i < line.length(); i++) {
+                char c = line.charAt(i);
+                if (c == '\\' && i + 1 < line.length()) {
+                    char next = line.charAt(++i);
+                    switch (next) {
+                        case 'n':
+                            sb.append('\n');
+                            break;
+                        case 'r':
+                            sb.append('\r');
+                            break;
+                        case 't':
+                            sb.append('\t');
+                            break;
+                        case 'u':
+                            sb.append((char) Integer.parseInt(line.substring(i + 1, i + 5), 16));
+                            i += 4;
+                            break;
+                        default:
+                            sb.append(next);
+                            break;
+                    }
+                } else if (c == '"') {
+                    break;
+                } else {
+                    sb.append(c);
+                }
+            }
+            frame.text = sb.toString();
+            return frame;
+        } catch (Exception e) {
+            return null;
+        }
+    }
+}
diff --git a/termux-app/app/src/main/java/com/termux/app/nobi/NobiRecordingManager.java b/termux-app/app/src/main/java/com/termux/app/nobi/NobiRecordingManager.java
new file mode 100644
index 0000000..998c6c8
--- /dev/null
+++ b/termux-app/app/src/main/java/com/termux/app/nobi/NobiRecordingManager.java
@@ -0,0 +1,139 @@
+package com.termux.app.nobi;
+
+import android.content.Context;
+import android.os.Handler;
+import android.os.Looper;
+
+import com.termux.terminal.TerminalSession;
+
+import java.io.File;
+import java.io.FileWriter;
+import java.io.IOException;
+
+/**
+ * v7 (37): session recording. Every second the terminal transcript is
+ * snapshotted; new text is appended to a .cast.json file as
+ * {"t": elapsedMs, "text": "..."} lines. Playback replays the snapshots
+ * with their original timing. This is snapshot playback (1s granularity),
+ * not byte-exact terminal recording — the emulator exposes no output hook.
+ */
+public final class NobiRecordingManager {
+
+    private static boolean recording = false;
+    private static String recordingName = null;
+    private static FileWriter writer = null;
+    private static Handler handler = null;
+    private static Runnable poller = null;
+    private static String lastText = "";
+    private static long startMs = 0;
+
+    private NobiRecordingManager() {
+    }
+
+    public static boolean isRecording() {
+        return recording;
+    }
+
+    public static String getRecordingName() {
+        return recordingName;
+    }
+
+    public static File recordingsDir(Context context) {
+        File dir = new File(context.getFilesDir(), "recordings");
+        dir.mkdirs();
+        return dir;
+    }
+
+    public static void start(Context context, TerminalSession session, String name) {
+        if (recording) return;
+        try {
+            String safe = name.replaceAll("[^A-Za-z0-9._-]", "_");
+            File file = new File(recordingsDir(context), safe + ".cast.json");
+            writer = new FileWriter(file, false);
+            lastText = currentTranscript(session);
+            startMs = System.currentTimeMillis();
+            recording = true;
+            recordingName = safe;
+            handler = new Handler(Looper.getMainLooper());
+            poller = new Runnable() {
+                @Override
+                public void run() {
+                    if (!recording) return;
+                    try {
+                        String now = currentTranscript(session);
+                        if (now.length() > lastText.length()
+                            && now.startsWith(lastText)) {
+                            String delta = now.substring(lastText.length());
+                            writer.write("{\"t\":"
+                                + (System.currentTimeMillis() - startMs)
+                                + ",\"text\":\"" + escape(delta) + "\"}\n");
+                            writer.flush();
+                            lastText = now;
+                        } else if (!now.equals(lastText)) {
+                            // Transcript scrolled/trimmed: anchor to the new text.
+                            lastText = now;
+                        }
+                    } catch (Exception ignored) {
+                    }
+                    if (recording && handler != null) handler.postDelayed(this, 1000);
+                }
+            };
+            handler.postDelayed(poller, 1000);
+        } catch (Exception e) {
+            recording = false;
+        }
+    }
+
+    public static void stop() {
+        recording = false;
+        if (handler != null && poller != null) handler.removeCallbacks(poller);
+        handler = null;
+        poller = null;
+        if (writer != null) {
+            try {
+                writer.close();
+            } catch (IOException ignored) {
+            }
+            writer = null;
+        }
+        recordingName = null;
+        lastText = "";
+    }
+
+    private static String currentTranscript(TerminalSession session) {
+        try {
+            return session.getEmulator().getScreen().getTranscriptText();
+        } catch (Exception e) {
+            return "";
+        }
+    }
+
+    static String escape(String text) {
+        StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < text.length(); i++) {
+            char c = text.charAt(i);
+            switch (c) {
+                case '\\':
+                    sb.append("\\\\");
+                    break;
+                case '"':
+                    sb.append("\\\"");
+                    break;
+                case '\n':
+                    sb.append("\\n");
+                    break;
+                case '\r':
+                    sb.append("\\r");
+                    break;
+                case '\t':
+                    sb.append("\\t");
+                    break;
+                default:
+                    if (c < 0x20) sb.append(String.format("\\u%04x", (int) c));
+                    else sb.append(c);
+                    break;
+            }
+        }
+        return sb.toString();
+    }
+}
diff --git a/termux-app/app/src/main/java/com/termux/app/nobi/NobiScriptInstaller.java b/termux-app/app/src/main/java/com/termux/app/nobi/NobiScriptInstaller.java
new file mode 100644
index 0000000..e8559d4
