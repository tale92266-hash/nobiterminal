+                        @Override
+                        public void onAnimationEnd(android.animation.Animator animation) {
+                            decor.removeView(overlay);
+                        }
+                    });
+                    fadeOut.start();
+                }
+            });
+            set.start();
+        } catch (Exception ignored) {
+        }
+    }
 
