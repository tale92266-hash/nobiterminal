+++ b/termux-app/nobicode/src/main/java/com/nobidev/nobicode/plugins/PluginActivity.kt
@@ -0,0 +1,142 @@
+package com.nobidev.nobicode.plugins
+
+import android.app.Activity
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.Button
+import android.widget.Switch
+import android.widget.TextView
+import android.widget.Toast
+import androidx.appcompat.app.AppCompatActivity
+import androidx.documentfile.provider.DocumentFile
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import com.google.android.material.dialog.MaterialAlertDialogBuilder
+import com.nobidev.nobicode.R
+import java.io.File
+
+/**
+ * Plugin store UI: installed plugins with enable/disable, import from a
+ * plugin.json/.zip file, delete. No network store: plugins are JSON
+ * manifests by design (no code execution), installed from files the user
+ * picks. A remote plugin catalogue is pending (needs Sam's call on where
+ * it should live).
+ */
+class PluginActivity : AppCompatActivity() {
+
+    private lateinit var list: RecyclerView
+    private lateinit var emptyText: TextView
+    private lateinit var importBtn: Button
+    private var plugins: List<PluginManager.Plugin> = emptyList()
+
+    companion object {
+        private const val REQ_IMPORT = 7001
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_plugins)
+        title = "Plugins"
+        list = findViewById(R.id.pluginList)
+        emptyText = findViewById(R.id.pluginEmpty)
+        importBtn = findViewById(R.id.pluginImportBtn)
+        list.layoutManager = LinearLayoutManager(this)
+        PluginManager.installSamplesIfEmpty(this)
+        PluginManager.refreshThemes(this)
+        refresh()
+        importBtn.setOnClickListener {
+            val intent = Intent(Intent.ACTION_OPEN_DOCUMENT)
+            intent.addCategory(Intent.CATEGORY_OPENABLE)
+            intent.type = "*/*"
+            intent.putExtra(Intent.EXTRA_MIME_TYPES, arrayOf("application/json", "application/zip"))
+            startActivityForResult(intent, REQ_IMPORT)
+        }
+    }
+
+    private fun refresh() {
+        plugins = PluginManager.list(this)
+        emptyText.visibility = if (plugins.isEmpty()) View.VISIBLE else View.GONE
+        list.adapter = PluginAdapter(plugins,
+            onToggle = { plugin, enabled ->
+                PluginManager.setEnabled(this, plugin, enabled)
+                Toast.makeText(this, plugin.name + if (enabled) " enabled" else " disabled", Toast.LENGTH_SHORT).show()
+            },
+            onDelete = { plugin ->
+                MaterialAlertDialogBuilder(this)
+                    .setTitle("Delete " + plugin.name + "?")
+                    .setPositiveButton("Delete") { _, _ ->
+                        if (PluginManager.delete(this, plugin)) refresh()
+                    }
+                    .setNegativeButton("Cancel", null)
+                    .show()
+            })
+    }
+
+    override fun onActivityResult(requestCode: Int, resultCode: Int, data: Intent?) {
+        super.onActivityResult(requestCode, resultCode, data)
+        if (requestCode != REQ_IMPORT || resultCode != Activity.RESULT_OK) return
+        val uri: Uri = data?.data ?: return
+        try {
+            val tmp = File(cacheDir, "plugin_import_" + System.currentTimeMillis())
+            contentResolver.openInputStream(uri)?.use { inp ->
+                tmp.outputStream().use { o -> inp.copyTo(o) }
+            }
+            // A bare plugin.json has no extension hint; sniff the magic bytes.
+            var isZip = tmp.name.endsWith(".zip", ignoreCase = true)
+            if (!isZip) {
+                try {
+                    tmp.inputStream().use { inp ->
+                        val b0 = inp.read()
+                        val b1 = inp.read()
+                        isZip = (b0 == 0x50 && b1 == 0x4B)
+                    }
+                } catch (e: Exception) {
+                }
+            }
+            val result = PluginManager.install(this, tmp)
+            result.onSuccess { id ->
+                Toast.makeText(this, "Installed plugin: $id", Toast.LENGTH_SHORT).show()
+                PluginManager.refreshThemes(this)
+                refresh()
+            }.onFailure { e ->
+                Toast.makeText(this, "Install failed: " + e.message, Toast.LENGTH_LONG).show()
+            }
+            tmp.delete()
+        } catch (e: Exception) {
+            Toast.makeText(this, "Import failed: " + e.message, Toast.LENGTH_LONG).show()
+        }
+    }
+
+    private inner class PluginAdapter(
+        private val items: List<PluginManager.Plugin>,
+        private val onToggle: (PluginManager.Plugin, Boolean) -> Unit,
+        private val onDelete: (PluginManager.Plugin) -> Unit
+    ) : RecyclerView.Adapter<PluginAdapter.VH>() {
+
+        override fun onCreateViewHolder(p: ViewGroup, viewType: Int): VH {
+            val v = LayoutInflater.from(p.context).inflate(R.layout.item_plugin, p, false)
+            return VH(v)
+        }
+
+        override fun onBindViewHolder(h: VH, pos: Int) = h.bind(items[pos])
+        override fun getItemCount() = items.size
+
+        inner class VH(v: View) : RecyclerView.ViewHolder(v) {
+            private val name: TextView = v.findViewById(R.id.pluginName)
+            private val detail: TextView = v.findViewById(R.id.pluginDetail)
+            private val toggle: Switch = v.findViewById(R.id.pluginToggle)
+            private val deleteBtn: Button = v.findViewById(R.id.pluginDeleteBtn)
+            fun bind(p: PluginManager.Plugin) {
+                name.text = p.name
+                detail.text = p.type + " · v" + p.version + " · " + p.id
+                toggle.isChecked = p.enabled
+                toggle.setOnCheckedChangeListener { _, checked -> onToggle(p, checked) }
+                deleteBtn.setOnClickListener { onDelete(p) }
+            }
+        }
+    }
+}
diff --git a/termux-app/nobicode/src/main/java/com/nobidev/nobicode/plugins/PluginManager.kt b/termux-app/nobicode/src/main/java/com/nobidev/nobicode/plugins/PluginManager.kt
new file mode 100644
index 0000000..6bc97f7
--- /dev/null
+++ b/termux-app/nobicode/src/main/java/com/nobidev/nobicode/plugins/PluginManager.kt
@@ -0,0 +1,264 @@
+package com.nobidev.nobicode.plugins
+
+import android.content.Context
+import com.nobidev.nobicode.theme.EditorTheme
+import com.nobidev.nobicode.theme.PluginThemes
+import org.json.JSONObject
+import java.io.File
+
+/**
+ * Plugin system (JSON manifests, no arbitrary code execution — a plugin can
+ * never run code, which keeps the editor safe).
+ *
+ * Supported plugin types:
+ * - theme:     { "colors": { "background": "#RRGGBB", "text": ..., ... } }
+ *              registers an EditorTheme selectable like built-in themes.
+ * - formatter: { "indentSize": 2, "trimTrailing": true, "finalNewline": true,
+ *              "languages": ["py", "js"] } — used by format-on-save when the
+ *              plugin is enabled and the file language matches.
+ * - snippets:  { "snippets": [{ "prefix": "log", "body": "...",
+ *              "language": "js" }] } — prefixes join the suggestion popup;
+ *              accepting one inserts its body.
+ * - ai-provider: { "endpoint": "https://...", "model": "..." } — an
+ *              OpenAI-compatible provider for the AI assistant. The API key
+ *              is NEVER stored in the manifest; it is entered in AI settings.
+ *
+ * Plugins live in filesDir/nobi_plugins/<id>/plugin.json. Import accepts a
+ * plugin.json file or a .zip containing one at its root. Two sample plugins
+ * ship in assets/nobi_plugins/ and are copied in on first use.
+ */
+object PluginManager {
+
+    data class Plugin(
+        val id: String,
+        val name: String,
+        val version: String,
+        val type: String,
+        val dir: File,
+        val manifest: JSONObject,
+        var enabled: Boolean
+    )
+
+    data class Snippet(val prefix: String, val body: String, val language: String)
+
+    private const val PREFS = "nobi_plugins"
+    private const val DISABLED_KEY = "disabled_ids"
+
+    fun pluginDir(context: Context): File =
+        File(context.filesDir, "nobi_plugins").also { if (!it.exists()) it.mkdirs() }
+
+    fun list(context: Context): List<Plugin> {
+        val dir = pluginDir(context)
+        val disabled = disabledIds(context)
+        val out = mutableListOf<Plugin>()
+        val children = dir.listFiles() ?: return out
+        for (child in children) {
+            if (!child.isDirectory) continue
+            val manifestFile = File(child, "plugin.json")
+            if (!manifestFile.isFile) continue
+            try {
+                val manifest = JSONObject(manifestFile.readText())
+                val id = manifest.optString("id", child.name)
+                out.add(
+                    Plugin(
+                        id = id,
+                        name = manifest.optString("name", id),
+                        version = manifest.optString("version", ""),
+                        type = manifest.optString("type", "unknown"),
+                        dir = child,
+                        manifest = manifest,
+                        enabled = id !in disabled
+                    )
+                )
+            } catch (e: Exception) {
+            }
+        }
+        return out.sortedBy { it.name.lowercase() }
+    }
+
+    private fun disabledIds(context: Context): Set<String> {
+        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        return prefs.getStringSet(DISABLED_KEY, emptySet()) ?: emptySet()
+    }
+
+    fun setEnabled(context: Context, plugin: Plugin, enabled: Boolean) {
+        val prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+        val disabled = disabledIds(context).toMutableSet()
+        if (enabled) disabled.remove(plugin.id) else disabled.add(plugin.id)
+        prefs.edit().putStringSet(DISABLED_KEY, disabled).apply()
+        plugin.enabled = enabled
+        if (plugin.type == "theme") {
+            if (enabled) registerTheme(plugin) else PluginThemes.unregister(plugin.id)
+        }
+    }
+
+    /** Install a plugin.json file (or a .zip containing one) into the dir. */
+    fun install(context: Context, source: File): Result<String> {
+        return try {
+            val dir = pluginDir(context)
+            val isZip = source.name.endsWith(".zip", ignoreCase = true) || hasZipMagic(source)
+            if (isZip) {
+                installZip(dir, source)
+            } else {
+                val manifest = JSONObject(source.readText())
+                val id = manifest.optString("id", "").ifBlank { return Result.failure(Exception("plugin.json has no id")) }
+                val target = File(dir, sanitize(id))
+                target.mkdirs()
+                source.copyTo(File(target, "plugin.json"), overwrite = true)
+                Result.success(id)
+            }
+        } catch (e: Exception) {
+            Result.failure(e)
+        }
+    }
+
+    private fun hasZipMagic(file: File): Boolean {
+        return try {
+            file.inputStream().use { inp -> inp.read() == 0x50 && inp.read() == 0x4B }
+        } catch (e: Exception) {
+            false
+        }
+    }
+
+    private fun installZip(dir: File, zip: File): Result<String> {
+        var manifestText: String? = null
+        var manifestId = ""
+        java.util.zip.ZipFile(zip).use { zf ->
+            val entries = zf.entries().toList()
+            val entry = entries.firstOrNull { it.name == "plugin.json" }
+                ?: entries.firstOrNull { it.name.endsWith("/plugin.json") }
+                ?: return Result.failure(Exception("No plugin.json in zip"))
+            manifestText = zf.getInputStream(entry).bufferedReader().readText()
+            val manifest = JSONObject(manifestText!!)
+            manifestId = manifest.optString("id", "")
+            if (manifestId.isBlank()) return Result.failure(Exception("plugin.json has no id"))
+            val target = File(dir, sanitize(manifestId))
+            target.mkdirs()
+            for (e in entries) {
+                if (e.isDirectory) continue
+                val name = e.name.substringAfterLast('/')
+                if (name.isEmpty()) continue
+                val out = File(target, name)
+                zf.getInputStream(e).use { inp -> out.outputStream().use { o -> inp.copyTo(o) } }
+            }
+        }
+        return Result.success(manifestId)
+    }
+
+    private fun sanitize(id: String): String =
+        id.replace(Regex("[^A-Za-z0-9_.-]"), "_")
+
+    /** Copy bundled sample plugins from assets on first use. */
+    fun installSamplesIfEmpty(context: Context) {
+        val dir = pluginDir(context)
+        val existing = dir.listFiles()?.any { File(it, "plugin.json").isFile } ?: false
+        if (existing) return
+        try {
+            val names = context.assets.list("nobi_plugins") ?: return
+            for (name in names) {
+                val target = File(dir, name)
+                target.mkdirs()
+                context.assets.open("nobi_plugins/$name/plugin.json").use { inp ->
+                    File(target, "plugin.json").outputStream().use { o -> inp.copyTo(o) }
+                }
+            }
+        } catch (e: Exception) {
+        }
+    }
+
+    /** Apply all enabled theme plugins to the runtime registry. */
+    fun refreshThemes(context: Context) {
+        for (plugin in list(context)) {
+            if (plugin.enabled && plugin.type == "theme") registerTheme(plugin)
+        }
+    }
+
+    private fun registerTheme(plugin: Plugin) {
+        try {
+            val colors = plugin.manifest.optJSONObject("colors") ?: return
+            fun color(key: String, fallback: Int): Int {
+                val raw = colors.optString(key, "")
+                if (raw.isBlank()) return fallback
+                return try {
+                    android.graphics.Color.parseColor(raw)
+                } catch (e: Exception) {
+                    fallback
+                }
+            }
+            val base = com.nobidev.nobicode.theme.Themes.DEFAULT
+            val theme = EditorTheme(
+                id = "plugin:" + plugin.id,
+                displayName = plugin.name,
+                isDark = plugin.manifest.optBoolean("dark", true),
+                background = color("background", base.background),
+                surface = color("surface", base.surface),
+                text = color("text", base.text),
+                caret = color("caret", base.caret),
+                selection = color("selection", base.selection),
+                currentLine = color("currentLine", base.currentLine),
+                gutterBg = color("gutterBg", base.gutterBg),
+                gutterText = color("gutterText", base.gutterText),
+                gutterActive = color("gutterActive", base.gutterActive),
+                keyword = color("keyword", base.keyword),
+                string = color("string", base.string),
+                comment = color("comment", base.comment),
+                number = color("number", base.number),
+                function = color("function", base.function),
+                type = color("type", base.type),
+                annotation = color("annotation", base.annotation)
+            )
+            PluginThemes.register(theme)
+        } catch (e: Exception) {
+        }
+    }
+
+    /** Enabled formatter plugin matching [ext], if any. */
+    fun formatterFor(context: Context, ext: String): JSONObject? {
+        for (plugin in list(context)) {
+            if (!plugin.enabled || plugin.type != "formatter") continue
+            val langs = plugin.manifest.optJSONArray("languages") ?: continue
+            for (i in 0 until langs.length()) {
+                if (langs.optString(i).equals(ext, ignoreCase = true)) return plugin.manifest
+            }
+        }
+        return null
+    }
+
+    /** Enabled snippet prefixes for [ext] (prefix -> body). */
+    fun snippetsFor(context: Context, ext: String): Map<String, String> {
+        val out = LinkedHashMap<String, String>()
+        for (plugin in list(context)) {
+            if (!plugin.enabled || plugin.type != "snippets") continue
+            val arr = plugin.manifest.optJSONArray("snippets") ?: continue
+            for (i in 0 until arr.length()) {
+                val s = arr.optJSONObject(i) ?: continue
+                val lang = s.optString("language", "")
+                if (lang.isBlank() || lang.equals(ext, ignoreCase = true)) {
+                    val prefix = s.optString("prefix", "")
+                    val body = s.optString("body", "")
+                    if (prefix.isNotBlank() && body.isNotBlank()) out[prefix] = body
+                }
+            }
+        }
+        return out
+    }
+
+    /** Enabled ai-provider plugin, if any (endpoint + model, never a key). */
+    fun aiProviderManifest(context: Context): JSONObject? {
+        for (plugin in list(context)) {
+            if (!plugin.enabled || plugin.type != "ai-provider") continue
+            return plugin.manifest
+        }
+        return null
+    }
+
+    fun delete(context: Context, plugin: Plugin): Boolean {
+        return try {
+            plugin.dir.deleteRecursively()
+            PluginThemes.unregister(plugin.id)
+            true
+        } catch (e: Exception) {
+            false
+        }
+    }
+}
diff --git a/termux-app/nobicode/src/main/java/com/nobidev/nobicode/preferences/EditorPreferences.kt b/termux-app/nobicode/src/main/java/com/nobidev/nobicode/preferences/EditorPreferences.kt
index b482342..3c77c28 100644
--- a/termux-app/nobicode/src/main/java/com/nobidev/nobicode/preferences/EditorPreferences.kt
+++ b/termux-app/nobicode/src/main/java/com/nobidev/nobicode/preferences/EditorPreferences.kt
@@ -183,4 +183,45 @@ class EditorPreferences(context: Context) {
     var snippetTipShown: Boolean
         get() = prefs.getBoolean("snippet_tip_shown", false)
         set(value) = prefs.edit().putBoolean("snippet_tip_shown", value).apply()
+
+    // ---- v7 prefs ----
+    /** v7 (64): file bookmarks (paths), distinct from line bookmarks. */
+    var fileBookmarks: List<String>
+        get() = prefs.getString("v7_file_bookmarks", "").orEmpty().split("\u0001").filter { it.isNotEmpty() }
+        set(value) = prefs.edit().putString("v7_file_bookmarks", value.take(50).joinToString("\u0001")).apply()
+
+    /** v7 (57): per-file run configs as JSON (path -> {command,args,env}). */
+    var runConfigs: String
+        get() = prefs.getString("v7_run_configs", "{}") ?: "{}"
+        set(value) = prefs.edit().putString("v7_run_configs", value).apply()
+
+    /** v7 (60): follow the terminal's cwd when the hook is installed. */
+    var followTerminalFolder: Boolean
+        get() = prefs.getBoolean("v7_follow_terminal_folder", true)
+        set(value) = prefs.edit().putBoolean("v7_follow_terminal_folder", value).apply()
+
+    /** v7 (35): vim modal editing. */
+    var vimMode: Boolean
+        get() = prefs.getBoolean("v7_vim_mode", false)
+        set(value) = prefs.edit().putBoolean("v7_vim_mode", value).apply()
+
+    /** v7 (86): editor font file path (user-imported .ttf), null = default. */
+    var fontPath: String?
+        get() = prefs.getString("v7_font_path", null)
+        set(value) = prefs.edit().putString("v7_font_path", value).apply()
+
+    /** v7 (87): layout density — "compact" or "comfortable" (via lineSpacing). */
+    var density: String
+        get() = prefs.getString("v7_density", "comfortable") ?: "comfortable"
+        set(value) = prefs.edit().putString("v7_density", value).apply()
+
+    /** v7 (85): glass look (translucent rounded panels) on/off. */
+    var glassLook: Boolean
+        get() = prefs.getBoolean("v7_glass_look", false)
+        set(value) = prefs.edit().putBoolean("v7_glass_look", value).apply()
+
+    /** v7 (31): time-aware editor theme (light by day, dark by night). */
+    var timeAwareTheme: Boolean
+        get() = prefs.getBoolean("v7_time_aware_theme", false)
+        set(value) = prefs.edit().putBoolean("v7_time_aware_theme", value).apply()
 }
diff --git a/termux-app/nobicode/src/main/java/com/nobidev/nobicode/theme/PluginThemes.kt b/termux-app/nobicode/src/main/java/com/nobidev/nobicode/theme/PluginThemes.kt
new file mode 100644
index 0000000..c5f4ac4
--- /dev/null
+++ b/termux-app/nobicode/src/main/java/com/nobidev/nobicode/theme/PluginThemes.kt
@@ -0,0 +1,26 @@
+package com.nobidev.nobicode.theme
+
+/**
+ * Runtime registry for plugin-provided themes. PluginManager registers here;
+ * Themes.byId consults this registry before its built-in list.
+ */
+object PluginThemes {
+
+    private val themes = LinkedHashMap<String, EditorTheme>()
+
+    @Synchronized
+    fun register(theme: EditorTheme) {
+        themes[theme.id] = theme
+    }
+
+    @Synchronized
+    fun unregister(pluginId: String) {
+        themes.remove("plugin:" + pluginId)
+    }
+
+    @Synchronized
+    fun get(id: String?): EditorTheme? = themes[id]
+
+    @Synchronized
+    fun all(): List<EditorTheme> = themes.values.toList()
+}
diff --git a/termux-app/nobicode/src/main/java/com/nobidev/nobicode/theme/Themes.kt b/termux-app/nobicode/src/main/java/com/nobidev/nobicode/theme/Themes.kt
index e7d0e34..a67dd04 100644
--- a/termux-app/nobicode/src/main/java/com/nobidev/nobicode/theme/Themes.kt
+++ b/termux-app/nobicode/src/main/java/com/nobidev/nobicode/theme/Themes.kt
@@ -78,5 +78,8 @@ object Themes {
     val DEFAULT = TOKYO
 
     fun byId(id: String?): EditorTheme =
-        ALL.firstOrNull { it.id == id } ?: DEFAULT
+        PluginThemes.get(id) ?: ALL.firstOrNull { it.id == id } ?: DEFAULT
+
+    /** Built-ins plus enabled plugin themes, for pickers. */
+    fun allWithPlugins(): List<EditorTheme> = ALL + PluginThemes.all()
 }
