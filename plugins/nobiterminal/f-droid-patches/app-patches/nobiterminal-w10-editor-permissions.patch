+    <string name="nobi_notifications_clear">Clear</string>
+    <string name="nobi_notifications_showing_latest">Showing the latest 30 notifications.</string>
+    <string name="nobi_permissions_title">Permissions</string>
+    <string name="nobi_permissions_intro">Tap a permission to grant it. Nothing is requested all at once — each permission is asked for only when you tap it, and saying no only limits that one feature.</string>
+    <string name="nobi_perm_granted">Granted</string>
+    <string name="nobi_perm_not_granted">Not granted</string>
+    <string name="nobi_perm_already_granted">Already granted</string>
