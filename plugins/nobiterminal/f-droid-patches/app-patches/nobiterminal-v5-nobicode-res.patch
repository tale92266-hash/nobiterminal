diff --git a/termux-app/nobicode/src/main/res/layout/activity_crash_report.xml b/termux-app/nobicode/src/main/res/layout/activity_crash_report.xml
new file mode 100644
index 0000000..6ce972a
--- /dev/null
+++ b/termux-app/nobicode/src/main/res/layout/activity_crash_report.xml
@@ -0,0 +1,74 @@
+<?xml version="1.0" encoding="utf-8"?>
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:orientation="vertical"
+    android:background="#12131B"
+    android:fitsSystemWindows="true">
+
+    <!-- Header -->
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="horizontal"
+        android:gravity="center_vertical"
+        android:padding="16dp"
+        android:background="#1A1B26">
+
+        <TextView
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_weight="1"
+            android:text="😢 NobiIDE Crash Ho Gaya"
+            android:textColor="#E6E9F5"
+            android:textSize="20sp"
+            android:textStyle="bold" />
+    </LinearLayout>
+
+    <!-- Scrollable crash log -->
+    <ScrollView
+        android:layout_width="match_parent"
+        android:layout_height="0dp"
+        android:layout_weight="1"
+        android:padding="16dp"
+        android:fillViewport="true">
+
+        <TextView
+            android:id="@+id/crashLogView"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:textColor="#B0B3C0"
+            android:textSize="12sp"
+            android:fontFamily="monospace"
+            android:textIsSelectable="true" />
+    </ScrollView>
+
+    <!-- Buttons always visible at bottom -->
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:orientation="horizontal"
+        android:padding="16dp"
+        android:gravity="center">
+
+        <Button
+            android:id="@+id/shareCrashBtn"
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_weight="1"
+            android:layout_marginEnd="8dp"
+            android:text="📤 Share"
+            android:textColor="#FFFFFF"
+            android:backgroundTint="#8B7CF6" />
+
+        <Button
+            android:id="@+id/restartAppBtn"
+            android:layout_width="0dp"
+            android:layout_height="wrap_content"
+            android:layout_weight="1"
+            android:layout_marginStart="8dp"
+            android:text="🔄 Restart"
+            android:textColor="#FFFFFF"
+            android:backgroundTint="#2A2B3A" />
+    </LinearLayout>
+</LinearLayout>
diff --git a/termux-app/nobicode/src/main/res/layout/activity_main.xml b/termux-app/nobicode/src/main/res/layout/activity_main.xml
