diff --git a/termux-app/app/src/main/res/values/dimens.xml b/termux-app/app/src/main/res/values/dimens.xml
--- /dev/null
+++ b/termux-app/app/src/main/res/values/dimens.xml
@@ -0,0 +1,37 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- v24 w47: design-system dimensions. 4dp spacing scale + component
+         metrics from the redesign spec. One source of truth: layouts and
+         code must use these instead of hardcoded dp values. -->
+    <dimen name="nobi_ds_spacing_4">4dp</dimen>
+    <dimen name="nobi_ds_spacing_8">8dp</dimen>
+    <dimen name="nobi_ds_spacing_12">12dp</dimen>
+    <dimen name="nobi_ds_spacing_16">16dp</dimen>
+    <dimen name="nobi_ds_spacing_20">20dp</dimen>
+    <dimen name="nobi_ds_spacing_24">24dp</dimen>
+    <dimen name="nobi_ds_corner_small">8dp</dimen>
+    <dimen name="nobi_ds_corner_medium">12dp</dimen>
+    <dimen name="nobi_ds_corner_large">16dp</dimen>
+    <dimen name="nobi_ds_corner_xl">20dp</dimen>
+    <dimen name="nobi_ds_corner_xxl">24dp</dimen>
+    <!-- TopAppBar (spec 2A). -->
+    <dimen name="nobi_ds_toolbar_height">56dp</dimen>
+    <!-- Session tabs bar (spec 2B). -->
+    <dimen name="nobi_ds_tabs_bar_height">40dp</dimen>
+    <dimen name="nobi_ds_tab_corner">12dp</dimen>
+    <!-- Navigation drawer (spec 3). -->
+    <dimen name="nobi_ds_drawer_width">304dp</dimen>
+    <dimen name="nobi_ds_drawer_item_height">54dp</dimen>
+    <dimen name="nobi_ds_drawer_icon_size">24dp</dimen>
+    <dimen name="nobi_ds_drawer_icon_text_gap">16dp</dimen>
+    <dimen name="nobi_ds_drawer_corner">24dp</dimen>
+    <!-- Extra keys (spec 4). -->
+    <dimen name="nobi_ds_extra_key_row_height">44dp</dimen>
+    <dimen name="nobi_ds_extra_key_gap">3dp</dimen>
+    <dimen name="nobi_ds_extra_key_corner">8dp</dimen>
+    <!-- Terminal workspace (spec 2C). -->
+    <dimen name="nobi_ds_terminal_padding">8dp</dimen>
+    <!-- Branding (spec 2D): ~50% smaller than the 132dp v7 marks. -->
+    <dimen name="nobi_ds_splash_mark_size">64dp</dimen>
+    <dimen name="nobi_ds_intro_icon_size">64dp</dimen>
+</resources>
diff --git a/termux-app/app/src/main/res/drawable/nobi_drawer_background.xml b/termux-app/app/src/main/res/drawable/nobi_drawer_background.xml
--- /dev/null
+++ b/termux-app/app/src/main/res/drawable/nobi_drawer_background.xml
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- v24 w47: drawer background — navy in both modes (w36) with 24dp
+     rounded TRAILING corners only (spec 3). The leading edge stays square
+     against the screen edge. Glass look swaps this drawable at runtime
+     (applyNobiDrawerDensityAndGlass caches it as the "original" bg). -->
+<shape xmlns:android="http://schemas.android.com/apk/res/android"
+    android:shape="rectangle">
+    <solid android:color="@color/nobi_ds_drawer_bg" />
+    <corners
+        android:topRightRadius="@dimen/nobi_ds_drawer_corner"
+        android:bottomRightRadius="@dimen/nobi_ds_drawer_corner" />
+</shape>
diff --git a/termux-app/app/src/main/res/values/nobi_ds_styles.xml b/termux-app/app/src/main/res/values/nobi_ds_styles.xml
--- /dev/null
+++ b/termux-app/app/src/main/res/values/nobi_ds_styles.xml
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- v24 w47: design-system styles (spec Phase 1). Applied by the
+         w48/w49 layout patches; kept separate from upstream styles.xml. -->
+    <style name="NobiDs.DrawerRow">
+        <item name="android:minHeight">@dimen/nobi_ds_drawer_item_height</item>
+        <item name="android:paddingTop">15dp</item>
+        <item name="android:paddingBottom">15dp</item>
+        <item name="android:paddingStart">@dimen/nobi_ds_spacing_16</item>
+        <item name="android:paddingEnd">@dimen/nobi_ds_spacing_16</item>
+        <item name="android:background">?attr/selectableItemBackground</item>
+        <item name="android:gravity">center_vertical</item>
+    </style>
+    <style name="NobiDs.DrawerSectionLabel">
+        <item name="android:textSize">12sp</item>
+        <item name="android:textStyle">bold</item>
+        <item name="android:textColor">@color/nobi_ds_drawer_text_secondary</item>
+        <item name="android:letterSpacing">0.08</item>
+        <item name="android:paddingStart">@dimen/nobi_ds_spacing_16</item>
+        <item name="android:paddingEnd">@dimen/nobi_ds_spacing_16</item>
+        <item name="android:paddingTop">@dimen/nobi_ds_spacing_16</item>
+        <item name="android:paddingBottom">6dp</item>
+    </style>
+    <style name="NobiDs.ToolbarTitle">
+        <item name="android:textSize">20sp</item>
+        <item name="android:textColor">@color/nobi_ds_text_primary</item>
+    </style>
+    <style name="NobiDs.ToolbarSubtitle">
+        <item name="android:textSize">12sp</item>
+        <item name="android:textColor">@color/nobi_ds_text_secondary</item>
+    </style>
+</resources>
