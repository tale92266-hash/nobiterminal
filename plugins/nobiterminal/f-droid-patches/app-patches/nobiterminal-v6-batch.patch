+            var firstSignificant = true
+            var inString = false
+            var stringDelim = '"'
+            var inChar = false
+            var i = 0
+            while (i < raw.length) {
+                val c = raw[i]
+                if (inBlockComment) {
+                    if (c == '*' && i + 1 < raw.length && raw[i + 1] == '/') {
