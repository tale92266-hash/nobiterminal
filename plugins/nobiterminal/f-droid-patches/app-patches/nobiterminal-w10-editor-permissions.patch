+++ b/termux-app/app/src/main/java/com/termux/app/nobi/NobiNotificationListenerService.java
@@ -0,0 +1,78 @@
+package com.termux.app.nobi;
+
+import android.app.Notification;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.service.notification.NotificationListenerService;
+import android.service.notification.StatusBarNotification;
+
+/**
+ * Notification reader (v10, READ-ONLY).
+ *
+ * This is not an auto-replier and it sends nothing anywhere: every posted
+ * notification is read locally, stored only in memory, and shown inside
+ * the app on the Notifications screen. The app's own notifications are
+ * never recorded, so the listener cannot feed on itself.
+ *
+ * Performance: the listener runs on the system's binder thread, does no
+ * disk I/O, no network, and no icon loading (rows show text only) — a
+ * posted notification costs one small object allocation.
+ */
+public class NobiNotificationListenerService extends NotificationListenerService {
+
+    /** Broadcast sent when a new record arrives; the screen refreshes on it. */
+    public static final String ACTION_UPDATED =
+            "com.termux.app.nobi.NOTIFICATIONS_UPDATED";
+
+    /** True when the user has enabled this listener in system settings. */
+    public static boolean isEnabled(Context context) {
+        String enabled = Settings.Secure.getString(
+                context.getContentResolver(), "enabled_notification_listeners");
+        if (enabled == null || enabled.isEmpty()) return false;
+        String mine = new ComponentName(context, NobiNotificationListenerService.class)
+                .flattenToString();
+        return enabled.contains(mine);
+    }
+
+    @Override
+    public void onNotificationPosted(StatusBarNotification sbn) {
+        if (sbn == null) return;
+        String pkg = sbn.getPackageName();
+        if (pkg == null || pkg.equals(getPackageName())) return;
+        Notification notification = sbn.getNotification();
+        if (notification == null) return;
+        Bundle extras = notification.extras;
+        CharSequence title = extras != null
+                ? extras.getCharSequence(Notification.EXTRA_TITLE) : null;
+        CharSequence text = extras != null
+                ? extras.getCharSequence(Notification.EXTRA_TEXT) : null;
+        String titleText = title != null ? title.toString() : "";
+        String bodyText = text != null ? text.toString() : "";
+        if (titleText.isEmpty() && bodyText.isEmpty()) return;
+
+        String appName = pkg;
+        try {
+            PackageManager pm = getPackageManager();
+            ApplicationInfo info = pm.getApplicationInfo(pkg, 0);
+            CharSequence label = pm.getApplicationLabel(info);
+            if (label != null && label.length() > 0) appName = label.toString();
+        } catch (Exception ignored) {
+            // Fall back to the package name; the record is still useful.
+        }
+
+        NobiNotificationStore.add(new NobiNotificationStore.Record(
+                appName, pkg, titleText, bodyText, sbn.getPostTime()));
+        sendBroadcast(new Intent(ACTION_UPDATED));
+    }
+
+    @Override
+    public void onNotificationRemoved(StatusBarNotification sbn) {
+        // Read-only history: a dismissed notification stays visible here
+        // until the user clears the list. Nothing is acted on.
+    }
+}
diff --git a/termux-app/app/src/main/java/com/termux/app/nobi/NobiNotificationStore.java b/termux-app/app/src/main/java/com/termux/app/nobi/NobiNotificationStore.java
new file mode 100644
index 0000000..2d85c3b
--- /dev/null
+++ b/termux-app/app/src/main/java/com/termux/app/nobi/NobiNotificationStore.java
@@ -0,0 +1,58 @@
+package com.termux.app.nobi;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * In-memory, read-only notification history (v10).
+ *
+ * Performance + privacy, both by design: records live only in memory
+ * (nothing is written to disk, nothing leaves the device), the list is
+ * bounded, and the Notifications screen shows only the newest slice, so
+ * opening it never inflates hundreds of rows.
+ */
+public final class NobiNotificationStore {
+
+    /** Hard cap on stored records; older ones are dropped. */
+    public static final int MAX_RECORDS = 100;
+
+    /** How many records the Notifications screen inflates at most. */
+    public static final int MAX_SHOWN = 30;
+
+    public static final class Record {
+        public final String appName;
+        public final String packageName;
+        public final String title;
+        public final String text;
+        public final long timeMillis;
+
+        public Record(String appName, String packageName, String title,
+                      String text, long timeMillis) {
+            this.appName = appName;
+            this.packageName = packageName;
+            this.title = title;
+            this.text = text;
+            this.timeMillis = timeMillis;
+        }
+    }
+
+    private static final List<Record> RECORDS = new ArrayList<>();
+
+    private NobiNotificationStore() {
+    }
+
+    public static synchronized void add(Record record) {
+        RECORDS.add(0, record);
+        while (RECORDS.size() > MAX_RECORDS) {
+            RECORDS.remove(RECORDS.size() - 1);
+        }
+    }
+
+    public static synchronized List<Record> snapshot() {
+        return new ArrayList<>(RECORDS);
+    }
+
+    public static synchronized void clear() {
+        RECORDS.clear();
+    }
+}
diff --git a/termux-app/app/src/main/java/com/termux/app/nobi/NobiNotificationsActivity.java b/termux-app/app/src/main/java/com/termux/app/nobi/NobiNotificationsActivity.java
new file mode 100644
index 0000000..84f0d13
--- /dev/null
+++ b/termux-app/app/src/main/java/com/termux/app/nobi/NobiNotificationsActivity.java
@@ -0,0 +1,149 @@
+package com.termux.app.nobi;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AppCompatActivity;
+import androidx.core.content.ContextCompat;
+
+import com.google.android.material.appbar.MaterialToolbar;
+import com.termux.R;
+
+import java.text.DateFormat;
+import java.util.Date;
+import java.util.List;
+
+/**
+ * Notifications screen (v10, read-only).
+ *
+ * Shows what the notification listener captured, newest first. If access
+ * is off, the screen explains why it is empty and offers the system
+ * settings page — it never pretends to show data it cannot read.
+ *
+ * Performance: rows are text only (no per-app icon loading, no images),
+ * at most MAX_SHOWN rows are inflated, and only while this screen is
+ * open. Nothing is re-read from disk on refresh.
+ */
+public class NobiNotificationsActivity extends AppCompatActivity {
+
+    private LinearLayout emptyState;
+    private TextView emptyText;
+    private Button grantButton;
+    private LinearLayout listContainer;
+    private LinearLayout footer;
+
+    private final BroadcastReceiver updateReceiver = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context context, Intent intent) {
+            refresh();
+        }
+    };
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_nobi_notifications);
+
+        MaterialToolbar toolbar = findViewById(R.id.nobiNotificationsToolbar);
+        toolbar.setNavigationOnClickListener(v -> finish());
+
+        emptyState = findViewById(R.id.nobiNotificationsEmpty);
+        emptyText = findViewById(R.id.nobiNotificationsEmptyText);
+        grantButton = findViewById(R.id.nobiNotificationsGrantButton);
+        listContainer = findViewById(R.id.nobiNotificationsList);
+        footer = findViewById(R.id.nobiNotificationsFooter);
+
+        grantButton.setOnClickListener(v -> {
+            try {
+                startActivity(new Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS));
+            } catch (Exception e) {
+                Toast.makeText(this, R.string.nobi_perm_open_settings_failed,
+                        Toast.LENGTH_SHORT).show();
+            }
+        });
+
+        Button clearButton = findViewById(R.id.nobiNotificationsClearButton);
+        clearButton.setOnClickListener(v -> {
+            NobiNotificationStore.clear();
+            refresh();
+        });
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        ContextCompat.registerReceiver(this, updateReceiver,
+                new IntentFilter(NobiNotificationListenerService.ACTION_UPDATED),
+                ContextCompat.RECEIVER_NOT_EXPORTED);
+        refresh();
+    }
+
+    @Override
+    protected void onPause() {
+        try {
+            unregisterReceiver(updateReceiver);
+        } catch (Exception ignored) {
+        }
+        super.onPause();
+    }
+
+    private void refresh() {
+        if (!NobiNotificationListenerService.isEnabled(this)) {
+            emptyState.setVisibility(View.VISIBLE);
+            emptyText.setText(R.string.nobi_notifications_empty_no_access);
+            grantButton.setVisibility(View.VISIBLE);
+            listContainer.setVisibility(View.GONE);
+            footer.setVisibility(View.GONE);
+            return;
+        }
+        List<NobiNotificationStore.Record> records = NobiNotificationStore.snapshot();
+        if (records.isEmpty()) {
+            emptyState.setVisibility(View.VISIBLE);
+            emptyText.setText(R.string.nobi_notifications_empty_none);
+            grantButton.setVisibility(View.GONE);
+            listContainer.setVisibility(View.GONE);
+            footer.setVisibility(View.GONE);
+            return;
+        }
+        emptyState.setVisibility(View.GONE);
+        listContainer.setVisibility(View.VISIBLE);
+        footer.setVisibility(View.VISIBLE);
+        listContainer.removeAllViews();
+        LayoutInflater inflater = LayoutInflater.from(this);
+        DateFormat timeFormat = DateFormat.getTimeInstance(DateFormat.SHORT);
+        int shown = 0;
+        for (NobiNotificationStore.Record record : records) {
+            if (shown >= NobiNotificationStore.MAX_SHOWN) break;
+            View row = inflater.inflate(R.layout.item_nobi_notification,
+                    listContainer, false);
+            ((TextView) row.findViewById(R.id.nobiNotificationApp))
+                    .setText(record.appName);
+            ((TextView) row.findViewById(R.id.nobiNotificationTime))
+                    .setText(timeFormat.format(new Date(record.timeMillis)));
+            TextView titleView = row.findViewById(R.id.nobiNotificationTitle);
+            if (record.title.isEmpty()) {
+                titleView.setVisibility(View.GONE);
+            } else {
+                titleView.setText(record.title);
+            }
+            TextView textView = row.findViewById(R.id.nobiNotificationText);
+            if (record.text.isEmpty()) {
+                textView.setVisibility(View.GONE);
+            } else {
+                textView.setText(record.text);
+            }
+            listContainer.addView(row);
+            shown++;
+        }
+    }
+}
diff --git a/termux-app/app/src/main/java/com/termux/app/nobi/NobiPermissionsActivity.java b/termux-app/app/src/main/java/com/termux/app/nobi/NobiPermissionsActivity.java
new file mode 100644
index 0000000..cbfd23f
--- /dev/null
+++ b/termux-app/app/src/main/java/com/termux/app/nobi/NobiPermissionsActivity.java
@@ -0,0 +1,210 @@
+package com.termux.app.nobi;
+
+import android.Manifest;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.net.Uri;
+import android.os.Build;
+import android.os.Bundle;
+import android.os.Environment;
+import android.os.PowerManager;
+import android.provider.Settings;
+import android.view.View;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AppCompatActivity;
+import androidx.core.app.ActivityCompat;
+import androidx.core.app.NotificationManagerCompat;
+import androidx.core.content.ContextCompat;
+
+import com.google.android.material.appbar.MaterialToolbar;
+import com.termux.R;
+
+/**
+ * Permissions hub (v10).
+ *
+ * One screen for every permission the app may need, each with what it is
+ * for and its live status. Nothing is requested in a batch at first run:
+ * tapping a row requests only that permission, and a denied permission
+ * simply leaves its feature degraded — the screen stays usable and the
+ * row stays tappable for a later grant.
+ *
+ * Deliberately NOT here (v10 scope): Device Admin and Accessibility.
+ * Neither was asked for, and both are high-risk grants.
+ *
+ * Performance: status checks are cheap system calls made only in
+ * onResume and after a request returns — there is no polling.
+ */
+public class NobiPermissionsActivity extends AppCompatActivity {
+
+    private static final int REQUEST_POST_NOTIFICATIONS = 101;
+    private static final int REQUEST_STORAGE = 102;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.activity_nobi_permissions);
+
+        MaterialToolbar toolbar = findViewById(R.id.nobiPermissionsToolbar);
+        toolbar.setNavigationOnClickListener(v -> finish());
+
+        findViewById(R.id.nobiPermissionsViewNotifications).setOnClickListener(v ->
+                startActivity(new Intent(this, NobiNotificationsActivity.class)));
+
+        findViewById(R.id.nobiPermRowNotifAccess).setOnClickListener(v -> {
+            if (NobiNotificationListenerService.isEnabled(this)) {
+                startActivity(new Intent(this, NobiNotificationsActivity.class));
+            } else {
+                openSettingsSafely(new Intent(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS));
+            }
+        });
+        findViewById(R.id.nobiPermRowOverlay).setOnClickListener(v -> {
+            if (Settings.canDrawOverlays(this)) {
+                showAlreadyGranted();
+            } else {
+                Intent intent = new Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION,
+                        Uri.parse("package:" + getPackageName()));
+                openSettingsSafely(intent);
+            }
+        });
+        findViewById(R.id.nobiPermRowAllFiles).setOnClickListener(v -> {
+            if (isAllFilesGranted()) {
+                showAlreadyGranted();
+            } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+                Intent intent = new Intent(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION,
+                        Uri.parse("package:" + getPackageName()));
+                openSettingsSafely(intent);
+            } else {
+                ActivityCompat.requestPermissions(this,
+                        new String[]{Manifest.permission.WRITE_EXTERNAL_STORAGE},
+                        REQUEST_STORAGE);
+            }
+        });
+        findViewById(R.id.nobiPermRowInstall).setOnClickListener(v -> {
+            if (getPackageManager().canRequestPackageInstalls()) {
+                showAlreadyGranted();
+            } else {
+                Intent intent = new Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES,
+                        Uri.parse("package:" + getPackageName()));
+                openSettingsSafely(intent);
+            }
+        });
+        findViewById(R.id.nobiPermRowBattery).setOnClickListener(v -> {
+            PowerManager pm = (PowerManager) getSystemService(Context.POWER_SERVICE);
+            if (pm != null && pm.isIgnoringBatteryOptimizations(getPackageName())) {
+                showAlreadyGranted();
+            } else {
+                Intent intent = new Intent(
+                        Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS,
+                        Uri.parse("package:" + getPackageName()));
+                openSettingsSafely(intent);
+            }
+        });
+        findViewById(R.id.nobiPermRowPostNotif).setOnClickListener(v -> {
+            if (isPostNotificationsGranted()) {
+                showAlreadyGranted();
+            } else if (Build.VERSION.SDK_INT >= 33) {
+                ActivityCompat.requestPermissions(this,
+                        new String[]{Manifest.permission.POST_NOTIFICATIONS},
+                        REQUEST_POST_NOTIFICATIONS);
+            } else {
+                Intent intent = new Intent(Settings.ACTION_APP_NOTIFICATION_SETTINGS)
+                        .putExtra(Settings.EXTRA_APP_PACKAGE, getPackageName());
+                openSettingsSafely(intent);
+            }
+        });
+        findViewById(R.id.nobiPermRowStorage).setOnClickListener(v -> {
+            if (isStorageGranted()) {
+                showAlreadyGranted();
+            } else if (Build.VERSION.SDK_INT >= 33) {
+                ActivityCompat.requestPermissions(this, new String[]{
+                        Manifest.permission.READ_MEDIA_IMAGES,
+                        Manifest.permission.READ_MEDIA_VIDEO,
+                        Manifest.permission.READ_MEDIA_AUDIO}, REQUEST_STORAGE);
+            } else {
+                ActivityCompat.requestPermissions(this, new String[]{
+                        Manifest.permission.READ_EXTERNAL_STORAGE,
+                        Manifest.permission.WRITE_EXTERNAL_STORAGE}, REQUEST_STORAGE);
+            }
+        });
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+        refreshStatuses();
+    }
+
+    @Override
+    public void onRequestPermissionsResult(int requestCode, String[] permissions,
+                                           int[] grantResults) {
+        super.onRequestPermissionsResult(requestCode, permissions, grantResults);
+        // Denied = degraded feature only; the row stays tappable for retry.
+        refreshStatuses();
+    }
+
+    private void refreshStatuses() {
+        setStatus(R.id.nobiPermStatusNotifAccess,
+                NobiNotificationListenerService.isEnabled(this));
+        setStatus(R.id.nobiPermStatusOverlay, Settings.canDrawOverlays(this));
+        setStatus(R.id.nobiPermStatusAllFiles, isAllFilesGranted());
+        setStatus(R.id.nobiPermStatusInstall,
+                getPackageManager().canRequestPackageInstalls());
+        PowerManager pm = (PowerManager) getSystemService(Context.POWER_SERVICE);
+        setStatus(R.id.nobiPermStatusBattery,
+                pm != null && pm.isIgnoringBatteryOptimizations(getPackageName()));
+        setStatus(R.id.nobiPermStatusPostNotif, isPostNotificationsGranted());
+        setStatus(R.id.nobiPermStatusStorage, isStorageGranted());
+    }
+
+    private void setStatus(int viewId, boolean granted) {
+        TextView status = findViewById(viewId);
+        status.setText(granted ? R.string.nobi_perm_granted
+                : R.string.nobi_perm_not_granted);
+    }
+
+    private boolean isAllFilesGranted() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+            return Environment.isExternalStorageManager();
+        }
+        return ContextCompat.checkSelfPermission(this,
+                Manifest.permission.WRITE_EXTERNAL_STORAGE)
+                == PackageManager.PERMISSION_GRANTED;
+    }
+
+    private boolean isPostNotificationsGranted() {
+        if (Build.VERSION.SDK_INT >= 33) {
+            return ContextCompat.checkSelfPermission(this,
+                    Manifest.permission.POST_NOTIFICATIONS)
+                    == PackageManager.PERMISSION_GRANTED;
+        }
+        return NotificationManagerCompat.from(this).areNotificationsEnabled();
+    }
+
+    private boolean isStorageGranted() {
+        if (Build.VERSION.SDK_INT >= 33) {
+            return ContextCompat.checkSelfPermission(this,
+                    Manifest.permission.READ_MEDIA_IMAGES)
+                    == PackageManager.PERMISSION_GRANTED;
+        }
+        return ContextCompat.checkSelfPermission(this,
+                Manifest.permission.READ_EXTERNAL_STORAGE)
+                == PackageManager.PERMISSION_GRANTED;
+    }
+
+    private void openSettingsSafely(Intent intent) {
+        try {
+            startActivity(intent);
+        } catch (Exception e) {
+            Toast.makeText(this, R.string.nobi_perm_open_settings_failed,
+                    Toast.LENGTH_SHORT).show();
+        }
+    }
+
+    private void showAlreadyGranted() {
+        Toast.makeText(this, R.string.nobi_perm_already_granted,
+                Toast.LENGTH_SHORT).show();
+    }
+}
