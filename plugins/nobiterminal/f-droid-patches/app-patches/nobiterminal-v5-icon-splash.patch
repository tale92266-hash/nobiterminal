diff --git a/termux-app/app/src/main/res/drawable/nobi_splash_background.xml b/termux-app/app/src/main/res/drawable/nobi_splash_background.xml
new file mode 100644
index 0000000..f5bc228
--- /dev/null
+++ b/termux-app/app/src/main/res/drawable/nobi_splash_background.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Branded cold-start background: brand navy with the neon N mark centered.
+     Shown only until the terminal activity draws; never a delay gate. -->
+<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:drawable="@color/nobi_splash_background" />
+    <item
+        android:width="132dp"
+        android:height="132dp"
+        android:gravity="center"
+        android:drawable="@drawable/ic_foreground" />
+</layer-list>
