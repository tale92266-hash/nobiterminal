+    private static String buildSetupScript() {
+        StringBuilder script = new StringBuilder();
+        script.append("#!/bin/sh\n");
+        script.append("# v23: visible Nobi repo setup + apt update with retries.\n");
+        script.append("# The repo list files were already written by NobiRepoSetup; this script\n");
+        script.append("# only shows the steps and runs apt update where the user can see it.\n");
+        script.append("MARKER_DIR=\"$PREFIX/tmp\"\n");
+        script.append("rm -f \"$MARKER_DIR/nobi-apt-update-done\" \"$MARKER_DIR/nobi-apt-update-failed\"\n");
+        script.append("echo \"NobiTerminal: Nobi sources set (10 lists).\"\n");
+        script.append("echo \"NobiTerminal: Official Termux sources disabled.\"\n");
+        script.append("if ! command -v apt >/dev/null 2>&1; then\n");
+        script.append("  echo \"NobiTerminal: apt update failed - apt not found.\"\n");
+        script.append("  touch \"$MARKER_DIR/nobi-apt-update-failed\"\n");
+        script.append("  exit 1\n");
+        script.append("fi\n");
+        script.append("echo \"NobiTerminal: Running apt update...\"\n");
+        script.append("LOG=\"$MARKER_DIR/nobi-apt-update.log\"\n");
+        script.append("attempt=1\n");
+        script.append("while [ $attempt -le 4 ]; do\n");
+        script.append("  apt update 2>&1 | tee \"$LOG\"\n");
+        script.append("  if grep -qE \"^(Hit|Get):.*tale92266-hash.github.io\" \"$LOG\"; then\n");
+        script.append("    echo \"NobiTerminal: apt update finished.\"\n");
+        script.append("    touch \"$MARKER_DIR/nobi-apt-update-done\"\n");
+        script.append("    exit 0\n");
+        script.append("  fi\n");
+        script.append("  if [ $attempt -eq 4 ]; then break; fi\n");
+        script.append("  case $attempt in\n");
+        script.append("    1) wait=5 ;;\n");
+        script.append("    2) wait=15 ;;\n");
+        script.append("    *) wait=30 ;;\n");
+        script.append("  esac\n");
+        script.append("  echo \"NobiTerminal: apt update failed - retrying $attempt/3 in ${wait}s...\"\n");
